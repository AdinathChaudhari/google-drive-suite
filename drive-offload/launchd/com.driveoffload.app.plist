<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.driveoffload.app</string>

    <!-- Launch the standalone bundled app binary (not the repo script). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/drive-offload.app/Contents/MacOS/drive-offload</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Relaunch only after an UNSUCCESSFUL exit, so the app's own "Quit"
         menu item (a clean exit 0 via rumps.quit_application) actually
         sticks. Plain `KeepAlive: true` resurrects the app immediately and
         makes Quit look broken. A crash still auto-heals.

         Note this also means SIGTERM (`launchctl kill`) counts as
         unsuccessful and WOULD relaunch — stop the app from outside with
         `launchctl bootout gui/$UID/com.driveoffload.app` instead, which is
         what drive-hub's Stop action does. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Reference template only — install-app.sh generates the real plist
         from $HOME at install time. -->
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Application Support/drive-offload/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Application Support/drive-offload/launchd.err.log</string>
</dict>
</plist>
